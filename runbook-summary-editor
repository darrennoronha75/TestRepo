## STEP 3 — The save function (~20 min)

New file in the `harness-actions` repo: `src/saveProjectSummary.ts`. Same imports and `nowIso()` helper as the existing CRUD file.

```typescript
const DEFAULT_CHAR_LIMIT = 600;   // same constant the module (and later the prompts) use
const ALLOWED_MODES = ["manual", "ai_generated", "ai_edited"];

@OntologyEditFunction()
export async function saveProjectSummary(
  projectSummaryId: string,             // subject key — real projectId for projects,
                                        // a slug for arbitrary subjects
  summaryText: string,
  sourceMode: string,                   // 'manual' | 'ai_generated' | 'ai_edited'
  sourceInteractionId: string | null,   // null on manual saves
  sourceOnePagerHash: string | null,    // null on manual saves
  userId: string,                       // explicit — functions can't read the acting user
): Promise<void> {
  if (!ALLOWED_MODES.includes(sourceMode)) throw new Error(`Invalid sourceMode ${sourceMode}`);
  const text = (summaryText ?? "").trim();
  if (!text) throw new Error("summaryText must be non-empty");

  const existing = await Objects.SaNewDevProjectSummary
    .where({ projectSummaryId }).first();
  const limit = existing?.charLimit ?? DEFAULT_CHAR_LIMIT;
  if (text.length > limit) throw new Error(`Summary is ${text.length} chars — limit is ${limit}`);

  // Upsert: modify the row if it exists, create it (PK = subject key) if not.
  const s = existing
    ? await Edits.get.SaNewDevProjectSummary(projectSummaryId)
    : Edits.create.SaNewDevProjectSummary(projectSummaryId);
  if (!existing) { s.firstSavedAt = nowIso(); s.charLimit = limit; }
  s.summaryText = text;
  s.sourceMode = sourceMode;
  s.sourceInteractionId = sourceInteractionId ?? null;
  s.sourceOnePagerHash = sourceOnePagerHash ?? null;
  s.lastSavedByUserId = userId;
  s.lastSavedAt = nowIso();
  s.version = (existing?.version ?? 0) + 1;
}
```

Note: **this action throws on validation failure on purpose** (unlike the never-throwing generate wrappers) — save is a user-facing form action, and Workshop surfaces the thrown message right at the Save button.

Commit → build → confirm the function publishes.

