## 3. The single reader — `getWidgetOverrideView`

Same principle as `getGenerationView` / `getProjectSummaryView`: **one function-backed variable per widget instance is the only source of page state.** Flat scalars, verdicts computed server-side.

```typescript
@Function()  // read-only — not an action
export async function getWidgetOverrideView(widgetKey: string): Promise<{
  exists: boolean;            // row registered?
  enabled: boolean;           // the persisted toggle
  hasValues: boolean;         // valuesJson non-empty
  rowCount: number;
  rawCsv: string;             // editor prefill ("" when none)
  valuesJson: string;         // handed onward to the Vega prep function
  expectedColumnsCsv: string; // "iSTEP, deliveries, slippageDays" — modal help line
  widgetLabel: string;
  statusLine: string;         // ready-to-render tag text
  lastUpdatedByUserId: string; lastUpdatedAt: string;
}> {
  const row = await Objects.WidgetOverride.where({ widgetKey }).first();
  if (!row) return { exists: false, enabled: false, hasValues: false,
    rowCount: 0, rawCsv: "", valuesJson: "", expectedColumnsCsv: "", widgetLabel: widgetKey,
    statusLine: "Live source data", lastUpdatedByUserId: "", lastUpdatedAt: "" };
  const hasValues = !!row.valuesJson;
  const statusLine = row.overrideEnabled && hasValues
    ? `OVERRIDDEN · ${row.rowCount} rows · ${row.lastUpdatedByUserId} · ${fmtWhen(row.lastUpdatedAt!)}`
    : hasValues ? "Override saved but OFF — showing live source data"
    : "Live source data";
  return {
    exists: true, enabled: !!row.overrideEnabled, hasValues,
    rowCount: row.rowCount ?? 0, rawCsv: row.rawCsv ?? "", valuesJson: row.valuesJson ?? "",
    expectedColumnsCsv: (row.expectedColumns ?? []).join(", "),
    widgetLabel: row.widgetLabel ?? widgetKey, statusLine,
    lastUpdatedByUserId: row.lastUpdatedByUserId ?? "", lastUpdatedAt: iso(row.lastUpdatedAt),
  };
}
// fmtWhen / iso: same helpers as the other readers.
```

