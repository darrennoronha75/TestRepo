### 2.1 `saveWidgetOverride` — full code (contract-routed; the parser IS the product)

```typescript
// saveWidgetOverride.ts — contract-routed save. The paste (from EITHER sheet of the controlled
// workbook) is matched against every registered widget contract; every widget whose FULL contract
// is present in the pasted headers gets updated. No widgetKey parameter.
// Throws on ANY problem: the action is one transaction, so an error anywhere writes NOTHING —
// previous overrides survive on every widget.
@OntologyEditFunction()
export async function saveWidgetOverride(csvText: string, userId: string): Promise<void> {
  const lines = (csvText ?? "").trim().split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
  if (lines.length < 2) throw new Error("Paste needs a header row plus at least one data row");

  // Excel copy-paste is TAB-separated; fall back to ; then , for real CSV files
  const sep = lines[0].includes("\t") ? "\t" : lines[0].includes(";") ? ";" : ",";
  const norm = (s: string) => s.trim().toLowerCase();
  const header = lines[0].split(sep).map(norm);

  // ---- route: which registered widgets does this paste serve? ----
  const registered = await Objects.WidgetOverride.all();          // tiny set
  const matched = registered.filter(r =>
    (r.expectedColumns ?? []).length >= 2 &&
    (r.expectedColumns ?? []).every(c => header.includes(norm(c))));
  if (matched.length === 0) {
    const contracts = registered
      .map(r => `${r.widgetKey}: [${(r.expectedColumns ?? []).join(", ")}]`).join("  ·  ");
    throw new Error(`Headers match no registered widget. Registered contracts — ${contracts}`);
  }

  for (const row of matched) {
    const expected = row.expectedColumns!;
    const idx = expected.map(c => header.indexOf(norm(c)));       // order-insensitive; extra columns ignored
    const keyCol = expected[0];                                   // convention: first = subject key (string)
    const out: Record<string, string | number>[] = [];
    const seen = new Set<string>();

    for (let i = 1; i < lines.length; i++) {
      const cells = lines[i].split(sep).map(c => c.trim());
      const rec: Record<string, string | number> = {};
      for (let j = 0; j < expected.length; j++) {
        const raw = cells[idx[j]];
        if (j === 0) {
          if (raw === undefined || raw === "")
            throw new Error(`Row ${i + 1}: '${keyCol}' is empty`);
          if (seen.has(raw)) throw new Error(`Row ${i + 1}: duplicate ${keyCol} '${raw}'`);
          seen.add(raw);
          rec[keyCol] = raw;
        } else {
          // BLANK metric cells are LEGAL (sheet may be partially filled): omit the metric —
          // the Vega merge keeps the source value for it (per-metric granularity, §5).
          // A row that is all-blank except the key is legal too and overrides nothing.
          if (raw === undefined || raw === "") continue;
          // tolerate thousands spaces; tolerate decimal comma ONLY when comma isn't the separator
          const cleaned = sep === "," ? raw.replace(/\s/g, "") : raw.replace(/\s/g, "").replace(",", ".");
          const num = Number(cleaned);
          if (!isFinite(num))
            throw new Error(`Row ${i + 1} ('${row.widgetKey}'): '${expected[j]}' is not a number ('${raw}')`);
          rec[expected[j]] = num;
        }
      }
      out.push(rec);
    }

    const e = await Edits.get.WidgetOverride(row.widgetKey);
    e.rawCsv = csvText;
    e.valuesJson = JSON.stringify(out);
    e.rowCount = out.length;
    e.overrideEnabled = true;                                     // pasting implies intent to use
    e.lastUpdatedByUserId = userId;
    e.lastUpdatedAt = nowIso();
    e.version = (e.version ?? 0) + 1;
  }
}
```

Routing semantics, spelled out: a sheet-1 paste (Project + MG columns) fully matches only `content_stability` → one row updated. A sheet-2 paste matches only `quality`. A combined table carrying all eleven columns matches both → **both updated from one paste** (legitimate, and visible — both tags flip). No match → error that teaches the user the contracts. Any error → nothing written anywhere.

### 2.2 The small ones (sketches)

```typescript
@OntologyEditFunction()
export async function registerWidgetOverride(
  widgetKey: string, widgetLabel: string, expectedColumns: string[], userId: string,
): Promise<void> {
  const existing = await Objects.WidgetOverride.where({ widgetKey }).first();
  if (existing) throw new Error(`'${widgetKey}' already registered`);
  if (expectedColumns.length < 2) throw new Error("Contract needs key column + ≥1 metric column");
  const e = Edits.create.WidgetOverride(widgetKey);
  e.widgetLabel = widgetLabel; e.expectedColumns = expectedColumns;
  e.overrideEnabled = false; e.version = 0;
  e.lastUpdatedByUserId = userId; e.lastUpdatedAt = nowIso();
}

@OntologyEditFunction()
export async function setWidgetOverrideEnabled(widgetKey: string, enabled: boolean, userId: string): Promise<void> {
  const e = await Edits.get.WidgetOverride(widgetKey);
  e.overrideEnabled = enabled; e.lastUpdatedByUserId = userId; e.lastUpdatedAt = nowIso();
}

@OntologyEditFunction()
export async function clearWidgetOverride(widgetKey: string, userId: string): Promise<void> {
  const e = await Edits.get.WidgetOverride(widgetKey);
  e.rawCsv = null; e.valuesJson = null; e.rowCount = null; e.overrideEnabled = false;
  e.lastUpdatedByUserId = userId; e.lastUpdatedAt = nowIso();
  e.version = (e.version ?? 0) + 1;
}
```

